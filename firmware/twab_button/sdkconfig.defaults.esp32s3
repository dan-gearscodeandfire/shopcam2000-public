# Seeed XIAO ESP32S3 — the current button board.
#
# Read AFTER sdkconfig.defaults, so anything set in both is decided here.

# 8 MB on the XIAO, not the 4 MB the WROOM devkit had.
CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y

# The console is the chip's own USB peripheral — there is no CP2102 on this
# board. That is most of why it sleeps at ~14 uA instead of milliamps, and it
# has one consequence worth knowing before you call the board dead:
#
# 🔴 The COM port IS the ESP32. Entering deep sleep makes the USB device
# disappear and the port vanish; waking re-enumerates it, often on a new port
# number. idf.py monitor will drop on every sleep cycle. On the CP2102 devkit
# the port stayed put no matter what the ESP32 did. Bench with
# TWABB_DEEP_SLEEP 0 and this stops being annoying.
#
# If USB CDC ever wedges hard enough that flashing fails, hold B (BOOT) and tap
# R (RESET) to force download mode.
CONFIG_ESP_CONSOLE_USB_SERIAL_JTAG=y

# PSRAM deliberately left OFF. The XIAO has 8 MB of OPI PSRAM; this firmware
# needs kilobytes, and the OPI interface occupies GPIO 33-37 and costs power to
# keep alive. Nothing here wants either.

# ⚠️ UNVERIFIED: the ~14 uA figure is Seeed's, measured at the BAT pads. Users
# report ~300 uA when fed from the 5V pin, because the charge IC and the
# regulator land in the path. The USB Serial/JTAG peripheral is also a known
# source of deep-sleep leakage on the S3. MEASURE it on this board before
# quoting a battery life -- do not inherit the number from this comment.
