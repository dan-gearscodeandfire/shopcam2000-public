# twab_bridge — the one OTA-capable board in the fleet.

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# OTA transport is plain HTTP on the shop LAN — but images must be SIGNED.
# Without signing, anything on the LAN that can serve (or spoof) the Controller
# could hand the bridge an arbitrary image, and this is the board that holds
# the WiFi credentials. Reuse the existing key:
#   copy ..\twab\secure_boot_signing_key.pem .
# (gitignored via *.pem — losing it means the next update needs USB.)
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_SECURE_SIGNED_APPS_NO_SECURE_BOOT=y
CONFIG_SECURE_SIGNED_APPS_ECDSA_SCHEME=y
CONFIG_SECURE_SIGNED_ON_UPDATE_NO_SECURE_BOOT=y
CONFIG_SECURE_BOOT_SIGNING_KEY="secure_boot_signing_key.pem"

# A new image must prove it can still reach the Controller (a successful POST
# or manifest fetch) before it is marked valid; otherwise the bootloader falls
# back to the previous slot. A bad OTA cannot strand the bridge.
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# HTTP server for /status and /cmd.
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_160=y
CONFIG_ESP_TASK_WDT_INIT=y
